rules_version = '2';

// OOO Friend stores trips in a single "trips" collection.
// This app has no authentication, so the rules below allow open
// read/write to that collection only. If you later add Firebase Auth,
// tighten these to `allow read, write: if request.auth != null;`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
